<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HoloCommerce - Your Cart</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Orbitron', sans-serif;
      background: #111;
      color: #eee;
      margin: 0;
      padding: 40px 20px;
    }

    h1 {
      text-align: center;
      margin-bottom: 30px;
    }

    .cart-container {
      max-width: 800px;
      margin: auto;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.1);
    }

    .item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #222;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 10px;
    }

    .item h3 {
      margin: 0;
    }

    .item button {
      background: #f44336;
      color: #fff;
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    .item button:hover {
      background: #e53935;
    }

    .summary {
      margin-top: 20px;
      font-size: 18px;
      text-align: center;
      color: #0ff;
    }

    .summary span {
      font-weight: bold;
      font-size: 20px;
    }

    #checkout {
      margin-top: 30px;
      width: 100%;
      padding: 12px;
      font-size: 16px;
      background: #00c853;
      color: #fff;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    #checkout:hover {
      background: #00b44a;
    }

    .empty-cart {
      text-align: center;
      color: #ff4081;
      font-size: 18px;
    }

    .back-to-shopping {
      text-align: center;
      margin-top: 20px;
    }

    .back-to-shopping a {
      color: #00c853;
      text-decoration: none;
      font-size: 16px;
    }

    .back-to-shopping a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <h1>Your HoloCart</h1>
  <div class="cart-container">
    <% if (cartItems.length === 0) { %>
      <p class="empty-cart">Your cart is empty.</p>
      <div class="back-to-shopping">
        <a href="/mall">Go back to shopping</a>
      </div>
    <% } else { %>
      <% let subtotal = 0; %>
      <% cartItems.forEach((item, index) => { %>
        <div class="item">
          <h3><%= item.name %></h3>
          <p>₹<%= item.price %></p>
          <form action="/remove-from-cart/<%= index %>" method="POST" style="margin: 0;">
            <button type="submit">Remove</button>
          </form>
        </div>
        <% subtotal += item.price; %>
      <% }); %>
      <div class="summary">
        Subtotal: <span>₹<%= subtotal %></span>
      </div>
      <!-- Updated to redirect to the /order-place page -->
      <a href="/placeorder">
        <button id="checkout">Proceed to Order</button>
      </a>
    <% } %>
  </div>
</body>
</html>
