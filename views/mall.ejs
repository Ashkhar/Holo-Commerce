<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>3D Virtual Mall</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
      background: #f2f2f2;
      font-family: sans-serif;
    }

    canvas {
      display: block;
    }

    .loading {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 1.2rem;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 10px 20px;
      border-radius: 8px;
      z-index: 10;
    }
  </style>
</head>
<body>
  <div class="loading" id="loadingText">Loading 3D Mall...</div>

  <script type="module">
    const loadingDiv = document.getElementById("loadingText");

    import("/scripts/main.js")
      .then(() => {
        loadingDiv.style.display = "none";
      })
      .catch(err => {
        loadingDiv.textContent = "Failed to load mall.";
        console.error("Mall loading error:", err);
      });
  </script>
</body>
</html>