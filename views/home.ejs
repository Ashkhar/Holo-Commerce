<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Home | Login/Register</title>
  <style>
    :root {
      --card-dark: rgba(27, 38, 59, 0.85);
      --btn-light: #e0e1dd;
      --btn-hover: #778da9;
      --text-light: #f5f5f5;
    }

    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text-light);
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: url('/images/bg12.jpg') no-repeat center center/cover;
      position: relative;
      overflow: hidden;
    }

    body::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 0;
    }

    .logo {
      position: absolute;
      top: 40px;
      max-width: 300px;
      z-index: 1;
      animation: fadeInDown 1.5s ease;
    }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .container {
      position: relative;
      z-index: 1;
      text-align: center;
      background: var(--card-dark);
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      animation: fadeIn 2s ease-in-out;
      max-width: 800px;
      margin: 20px;
      margin-top: 230px;
    }

    h1 {
      font-size: 2.2rem;
      margin-bottom: 30px;
      background: linear-gradient(90deg, #a8dadc, #f1faee, #a8dadc);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: gradientMove 4s linear infinite, fadeInUp 1.5s ease;
    }

    .buttons {
      display: flex;
      gap: 20px;
      justify-content: center;
    }

    .buttons button {
      opacity: 0;
      transform: translateY(30px);
      animation: slideUpFade 1s ease forwards;
      padding: 12px 24px;
      font-size: 1rem;
      font-weight: bold;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      background-color: var(--btn-light);
      color: #1b263b;
      transition: background-color 0.3s ease;
    }

    .buttons button:nth-child(1) {
      animation-delay: 1.2s;
    }

    .buttons button:nth-child(2) {
      animation-delay: 1.4s;
    }

    .buttons button:hover {
      background-color: var(--btn-hover);
      color: white;
    }

    @keyframes gradientMove {
      0% { background-position: 0% 50%; }
      100% { background-position: 200% 50%; }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes fadeInUp {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideUpFade {
      0% {
        opacity: 0;
        transform: translateY(30px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
  <!-- Logo above the container -->
  <img src="/images/logo.png" alt="HoloCommerce Logo" class="logo" />

  <div class="container">
    <h1>Hello, Welcome to shopping with augmented reality experience in 3D</h1>

    <!-- Flash message (optional) -->
    <% if (typeof message !== 'undefined') { %>
      <p style="color: lightgreen;"><%= message %></p>
    <% } %>

    <div class="buttons">
      <button onclick="location.href='/login'">Login</button>
      <button onclick="location.href='/register'">Register</button>
    </div>
  </div>
</body>
</html>